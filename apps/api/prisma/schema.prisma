generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  noivo
  cerimonialista
  padrinho
  convidado
}

enum GastoStatus {
  pendente
  pago
  cancelado
}

enum TarefaStatus {
  pendente
  aprovado
  feito
  rejeitado
  cancelado
}

enum Prioridade {
  baixa
  media
  alta
}

enum DestinoTarefa {
  noivos
  padrinho
}

enum LadoConvidado {
  noivo
  noiva
  ambos
}

enum RsvpStatus {
  pendente
  sim
  nao
  talvez
}

enum TipoPadrinho {
  padrinho
  madrinha
}

enum FotoTipo {
  noivos
  evento
  outro
}

enum TipoDespedida {
  solteiro
  solteira
}

enum AudienciaPresente {
  convidados
  padrinhos
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  role         UserRole
  nome         String   @default("")
  telefone     String   @default("")
  convidadoId  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  convidado Convidado? @relation(fields: [convidadoId], references: [id], onDelete: SetNull)
  tarefasCriadas Tarefa[] @relation("TarefaCriador")
  compromissosCriados Compromisso[] @relation("CompromissoCriador")
}

model CasamentoConfig {
  id                 String    @id @default(uuid())
  nomeNoivo          String
  nomeNoiva          String
  dataCerimonia      DateTime?
  local              String?
  localCerimonia     String?
  enderecoCerimonia  String?
  localFesta         String?
  enderecoFesta      String?
  capaUrl            String?
  whatsapp           String?
  mensagemBoasVindas String?
  updatedAt          DateTime  @updatedAt
}

model Gasto {
  id            String      @id @default(uuid())
  descricao     String
  categoria     String
  valorPrevisto Decimal     @default(0) @db.Decimal(12, 2)
  valorReal     Decimal?    @db.Decimal(12, 2)
  status        GastoStatus @default(pendente)
  dataPrevista  DateTime?   @db.Date
  dataPagamento DateTime?   @db.Date
  observacoes   String?
  createdAt     DateTime    @default(now())
}

model Convidado {
  id            String        @id @default(uuid())
  nome          String
  telefone      String?
  email         String?
  lado          LadoConvidado @default(ambos)
  mesa          String?
  ehCrianca     Boolean       @default(false)
  acompanhantes Json          @default("[]")
  token         String?       @unique
  rsvp          RsvpStatus    @default(pendente)
  observacoes   String?
  createdAt     DateTime      @default(now())

  user          User?
  padrinho      Padrinho?
  presentes     Presente[]
  despedidaPart DespedidaParticipante[]
  convites      ConviteAcesso[]
}

model Padrinho {
  id          String       @id @default(uuid())
  convidadoId String       @unique
  tipo        TipoPadrinho
  papel       String?
  ordem       Int          @default(0)
  createdAt   DateTime     @default(now())

  convidado Convidado @relation(fields: [convidadoId], references: [id], onDelete: Cascade)
  tarefas   Tarefa[]
}

model Tarefa {
  id         String        @id @default(uuid())
  titulo     String
  descricao  String?
  status     TarefaStatus  @default(pendente)
  prioridade Prioridade    @default(media)
  destino    DestinoTarefa @default(noivos)
  prazo      DateTime?     @db.Date
  padrinhoId String?
  criadoPor  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  padrinho Padrinho? @relation(fields: [padrinhoId], references: [id], onDelete: SetNull)
  criador  User?     @relation("TarefaCriador", fields: [criadoPor], references: [id], onDelete: SetNull)
}

model Compromisso {
  id        String    @id @default(uuid())
  titulo    String
  descricao String?
  inicio    DateTime
  fim       DateTime?
  local     String?
  criadoPor String?
  createdAt DateTime  @default(now())

  criador User? @relation("CompromissoCriador", fields: [criadoPor], references: [id], onDelete: SetNull)
}

model CardapioItem {
  id        String  @id @default(uuid())
  titulo    String
  descricao String?
  ordem     Int     @default(0)
}

model AtracaoItem {
  id        String  @id @default(uuid())
  titulo    String
  descricao String?
  horario   String?
  ordem     Int     @default(0)
}

model ConviteAcesso {
  id          String   @id @default(uuid())
  token       String   @unique
  role        UserRole
  nome        String   @default("")
  convidadoId String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())

  convidado Convidado? @relation(fields: [convidadoId], references: [id], onDelete: SetNull)
}

model Foto {
  id        String   @id @default(uuid())
  tipo      FotoTipo
  url       String
  legenda   String?
  publico   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Presente {
  id                     String            @id @default(uuid())
  nome                   String
  descricao              String?
  link                   String?
  valorEstimado          Decimal?          @db.Decimal(12, 2)
  imagemUrl              String?
  ativo                  Boolean           @default(true)
  audiencia              AudienciaPresente @default(convidados)
  reservadoPorConvidadoId String?
  reservadoEm            DateTime?
  createdAt              DateTime          @default(now())

  reservadoPor Convidado? @relation(fields: [reservadoPorConvidadoId], references: [id], onDelete: SetNull)
}

model DespedidaEvento {
  tipo        TipoDespedida @id
  data        DateTime?
  local       String?
  endereco    String?
  observacoes String?
}

model DespedidaParticipante {
  id          String        @id @default(uuid())
  nome        String
  tipo        TipoDespedida
  telefone    String?
  confirmado  Boolean       @default(false)
  observacoes String?
  convidadoId String?
  createdAt   DateTime      @default(now())

  convidado Convidado? @relation(fields: [convidadoId], references: [id], onDelete: SetNull)
}
